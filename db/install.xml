<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/suap/db" VERSION="2026012200"
       COMMENT="Relatórios consolidados de minicursos autoinstrucionais">

  <TABLES>

    <TABLE NAME="local_suap_relatorio_cursos_autoinstrucionais"
           COMMENT="Snapshot de minicursos agrupados por nome do curso e campus">

      <FIELDS>

        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>

        <!-- Identificação lógica -->
        <FIELD NAME="curso_nome" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="campus" TYPE="char" LENGTH="255" NOTNULL="true"/>

        <FIELD NAME="diario_tipo"         TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="quantidade_cursos"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="1"/>

        <!-- Métricas -->
        <FIELD NAME="total_enrolled"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="accessed"            TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="no_access"           TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>

        <FIELD NAME="final_exam_takers"   TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="passed"              TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="failed"              TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>

        <FIELD NAME="avg_grade"           TYPE="number" LENGTH="10" DECIMALS="2"  NOTNULL="true" DEFAULT="0"/>

        <FIELD NAME="with_certificate"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="without_certificate" TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completed"           TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>

        <!-- Controle -->
        <FIELD NAME="timegenerated" TYPE="int" LENGTH="10" NOTNULL="true"/>

      </FIELDS>

      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>

      <INDEXES>
        <INDEX NAME="idx_curso_nome"    UNIQUE="false" FIELDS="curso_nome"/>
        <INDEX NAME="idx_campus"        UNIQUE="false" FIELDS="campus"/>
        <INDEX NAME="idx_diario_tipo"   UNIQUE="false" FIELDS="diario_tipo"/>
        <INDEX NAME="idx_timegenerated" UNIQUE="false" FIELDS="timegenerated"/>
      </INDEXES>

    </TABLE>

    <TABLE NAME="local_suap_restricoes_autoinscricao" COMMENT="Snapshot de restrições de autoinscrição em minicursos">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"     NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"      TYPE="int"  LENGTH="10"     NOTNULL="true"/>
        <FIELD NAME="chave"         TYPE="char" LENGTH="255"    NOTNULL="true"/>
        <FIELD NAME="restricao"     TYPE="char" LENGTH="255"    NOTNULL="true"/>
        <FIELD NAME="descricao"     TYPE="text"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10"     NOTNULL="true"/>
      </FIELDS>

      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>

      <INDEXES>
        <INDEX NAME="idx_courseid"  UNIQUE="false" FIELDS="courseid"  />
        <INDEX NAME="idx_chave"     UNIQUE="false" FIELDS="chave"     />
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_suap_user_audit" COMMENT="Trilha de auditoria de alterações em usuários">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10"   NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10"   NOTNULL="true"/>
        <FIELD NAME="targetuserid"  TYPE="int"  LENGTH="10"   NOTNULL="true"/>
        <FIELD NAME="action"        TYPE="char" LENGTH="30"   NOTNULL="true"/>
        <FIELD NAME="field"         TYPE="char" LENGTH="100"/>
        <FIELD NAME="oldvalue"      TYPE="char" LENGTH="1000"/>
        <FIELD NAME="newvalue"      TYPE="char" LENGTH="1000"/>
        <FIELD NAME="actoruserid"   TYPE="int"  LENGTH="10"   NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="actorlabel"    TYPE="char" LENGTH="100"  NOTNULL="true"/>
        <FIELD NAME="origin"        TYPE="char" LENGTH="10"   NOTNULL="true"/>
        <FIELD NAME="ip"            TYPE="char" LENGTH="45"/>
        <FIELD NAME="requestref"    TYPE="char" LENGTH="100"/>
        <FIELD NAME="eventname"     TYPE="char" LENGTH="255"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_target_time" UNIQUE="false" FIELDS="targetuserid, timecreated"/>
        <INDEX NAME="idx_actor"       UNIQUE="false" FIELDS="actoruserid"/>
        <INDEX NAME="idx_actorlabel"  UNIQUE="false" FIELDS="actorlabel"/>
        <INDEX NAME="idx_timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
