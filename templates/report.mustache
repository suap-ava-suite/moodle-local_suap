{{!
    @template local_suap/report

    Template for rendering SUAP courses report.

    Context variables required for this template:
    * hasdata - boolean
    * lastupdated - string
    * nodatamessage - string
    * cursos - array of courses

    Example context (json):
    {
        "hasdata": true,
        "lastupdated": "29/08/2026 16:00",
        "nodatamessage": "Nenhum dado encontrado.",
        "cursos": [
            {
                "curso_id": "1",
                "curso_nome": "Curso Exemplo",
                "campus_list": [
                    {
                        "campus_nome": "CNAT",
                        "total_enrolled": 10,
                        "accessed": 8,
                        "no_access": 2,
                        "pct_accessed": 80,
                        "final_exam_takers": 5,
                        "pct_exam_takers": 50,
                        "passed": 4,
                        "failed": 1,
                        "pct_passed": 80,
                        "avg_grade": 8.5,
                        "with_certificate": 4,
                        "without_certificate": 0,
                        "completed": 4,
                        "pct_completed": 40
                    }
                ]
            }
        ]
    }
}}
<div class="local-suap-relatorio">
    {{#hasdata}}
        <div class="alert alert-info mb-4">
            <i class="fa fa-clock-o"></i> {{#str}} last_updated, local_suap {{/str}} {{lastupdated}}
        </div>

        <div class="accordion" id="accordion-cursos">
            {{#cursos}}
                <div class="card mb-2">
                    <div class="card-header" id="heading-{{curso_id}}">
                        <h2 class="mb-0">
                            <button class="btn btn-link btn-block text-left collapsed d-flex justify-content-between align-items-center" 
                                    type="button" 
                                    data-toggle="collapse" 
                                    data-target="#collapse-{{curso_id}}" 
                                    aria-expanded="false" 
                                    aria-controls="collapse-{{curso_id}}">
                                <strong>{{curso_nome}}</strong>
                                <i class="fa fa-chevron-down accordion-icon"></i>
                            </button>
                        </h2>
                    </div>
                    <div id="collapse-{{curso_id}}" 
                         class="collapse" 
                         aria-labelledby="heading-{{curso_id}}"
                         data-parent="#accordion-cursos">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-sm mb-0">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>{{#str}} campus, local_suap {{/str}}</th>
                                            <th>{{#str}} total_enrolled, local_suap {{/str}}</th>
                                            <th>{{#str}} accessed, local_suap {{/str}}</th>
                                            <th>{{#str}} never_accessed, local_suap {{/str}}</th>
                                            <th>{{#str}} pct_access, local_suap {{/str}}</th>
                                            <th>{{#str}} final_exam_takers, local_suap {{/str}}</th>
                                            <th>{{#str}} pct_final_exam_takers, local_suap {{/str}}</th>
                                            <th>{{#str}} passed, local_suap {{/str}}</th>
                                            <th>{{#str}} failed, local_suap {{/str}}</th>
                                            <th>{{#str}} pct_passed, local_suap {{/str}}</th>
                                            <th>{{#str}} avg_grade, local_suap {{/str}}</th>
                                            <th>{{#str}} with_certificate, local_suap {{/str}}</th>
                                            <th>{{#str}} eligible_without_certificate, local_suap {{/str}}</th>
                                            <th>{{#str}} completed, local_suap {{/str}}</th>
                                            <th>{{#str}} pct_completed, local_suap {{/str}}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#campus_list}}
                                            <tr>
                                                <td><strong>{{campus_nome}}</strong></td>
                                                <td>{{total_enrolled}}</td>
                                                <td>{{accessed}}</td>
                                                <td>{{no_access}}</td>
                                                <td>{{pct_accessed}}%</td>
                                                <td>{{final_exam_takers}}</td>
                                                <td>{{pct_exam_takers}}%</td>
                                                <td class="table-success">{{passed}}</td>
                                                <td class="table-danger">{{failed}}</td>
                                                <td>{{pct_passed}}%</td>
                                                <td>{{avg_grade}}</td>
                                                <td>{{with_certificate}}</td>
                                                <td>{{without_certificate}}</td>
                                                <td class="table-info">{{completed}}</td>
                                                <td>{{pct_completed}}%</td>
                                            </tr>
                                        {{/campus_list}}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            {{/cursos}}
        </div>
    {{/hasdata}}

    {{^hasdata}}
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i> {{nodatamessage}}
        </div>
    {{/hasdata}}
</div>